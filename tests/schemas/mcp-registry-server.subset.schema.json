{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Offline subset of the MCP registry server.json schema (2025-12-11): required fields and the mcpb package shape.",
  "type": "object",
  "required": ["name", "description", "version", "packages"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-zA-Z0-9.-]+/[a-zA-Z0-9._-]+$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "maxLength": 255 },
    "repository": {
      "type": "object",
      "required": ["url", "source"],
      "properties": { "url": { "type": "string" }, "source": { "type": "string" } }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["registryType", "identifier", "fileSha256", "transport"],
        "properties": {
          "registryType": { "const": "mcpb" },
          "identifier": { "type": "string", "pattern": "^https://github\\.com/.+\\.mcpb$" },
          "fileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "transport": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "const": "stdio" } }
          }
        }
      }
    }
  }
}
